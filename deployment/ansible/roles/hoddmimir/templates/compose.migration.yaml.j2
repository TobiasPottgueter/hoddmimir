---
services:
  schema-migration:
    image: {{ hoddmimir_data_worker_image | to_json }}
    command: [doctrine:migrations:migrate, --no-interaction, --allow-no-migration, --no-ansi]
    environment:
      APP_ENV: prod
      APP_DEBUG: "0"
      APP_TIMEZONE: {{ hoddmimir_timezone | to_json }}
      APP_SECRET_FILE: /run/secrets/app_secret
      DATABASE_HOST: mariadb
      DATABASE_PORT: "3306"
      DATABASE_NAME: {{ hoddmimir_database_name | to_json }}
      DATABASE_USER: hoddmimir_migration
      DATABASE_PASSWORD_FILE: /run/secrets/mariadb_migration_password
    secrets: [app_secret, mariadb_migration_password]
    networks: [internal]
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    tmpfs:
      - /tmp:mode=1777
      - /app/var:uid=10001,gid=10001,mode=0770
    init: true
    restart: "no"
