{
  "$schema": "vendor/infection/infection/resources/schema.json",
  "source": {
    "directories": [
      "src/Domain",
      "src/Application/Collector",
      "src/Application/Monitoring",
      "src/Application/Inventory/Connection",
      "src/Application/Inventory/Pve",
      "src/Application/Inventory/Pbs",
      "src/Application/Inventory/Capability",
      "src/Application/Inventory/PbsContent"
    ]
  },
  "timeout": 60,
  "threads": "max",
  "testFramework": "phpunit",
  "mutators": {
    "@default": true
  },
  "minMsi": 90,
  "ignoreMsiWithNoMutations": false,
  "timeoutsAsEscaped": true,
  "maxTimeouts": 0,
  "logs": {
    "text": "var/mutation/critical/escaped-mutants.log",
    "summary": "var/mutation/critical/summary.log",
    "summaryJson": "var/mutation/critical/summary.json",
    "perMutator": "var/mutation/critical/per-mutator.md"
  },
  "tmpDir": "var/mutation/tmp-critical"
}
