<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory="var/phpunit-coverage-mariadb"
         colors="true"
         failOnEmptyTestSuite="true"
         failOnRisky="true"
         failOnWarning="true">
    <php>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="APP_DEBUG" value="0" force="true"/>
        <server name="KERNEL_CLASS" value="App\Kernel" force="true"/>
    </php>

    <testsuites>
        <testsuite name="mariadb-unit">
            <directory>tests/Unit/Infrastructure/Persistence/MariaDb</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <coverage includeUncoveredFiles="true" pathCoverage="true"/>

    <source>
        <include>
            <directory suffix=".php">src/Infrastructure/Persistence/MariaDb</directory>
        </include>
    </source>
</phpunit>
