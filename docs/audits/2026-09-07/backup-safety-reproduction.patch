+    public function testAuditUnknownAllowsAnotherAutomaticSubmission(): void
+    {
+        $this->testProvenAbsentAmbiguousSubmissionBecomesUnknownExactlyOnce();
+        $source = new DbalAutomaticShadowEvaluationSource($this->connection());
+        self::assertTrue($this->shadowCandidate($source)->activeRequestAbsent);
+        $nextAt = $this->now->modify('+120 seconds');
+        $cycleId = self::id('audit-next-cycle');
+        $cycle = $this->connection()->fetchAssociative('SELECT * FROM collector_cycles WHERE cycle_token=:id', ['id'=>self::id('cycle')]);
+        self::assertIsArray($cycle);
+        $this->connection()->update('collector_cycles', ['status'=>'succeeded','finished_at'=>self::format($this->now)], ['cycle_token'=>self::id('cycle')]);
+        $cycle['cycle_token']=$cycleId; $cycle['fencing_token']=2;
+        $cycle['scheduled_for']=self::format($nextAt); $cycle['started_at']=self::format($nextAt);
+        $cycle['heartbeat_at']=self::format($nextAt); $cycle['status']='running';
+        $this->connection()->insert('collector_cycles',$cycle);
+        $this->connection()->update('collector_schedule',['lease_token'=>$cycleId,'lease_fencing_token'=>2],['schedule_name'=>'inventory']);
+        $this->connection()->update('guests',['is_template'=>1],['id'=>self::id('guest-b')]);
+        $lease=new CollectorLease(new CollectorWorkerId(self::id('collector')),new CollectorCycleToken($cycleId),2,$this->now->modify('+1 hour'));
+        $evaluator=new \App\Application\Scheduler\Shadow\RunAutomaticShadowEvaluation(
+            $source,
+            new \App\Application\Scheduler\Shadow\PersistShadowEvaluation(new \App\Infrastructure\Persistence\MariaDb\DbalShadowEvaluationStore($this->connection())),
+            new \App\Domain\Scheduler\EligibilityEvaluator(),new EvidenceFreshnessPolicy(),
+            new \App\Domain\Scheduler\ReasonSelector(),new \App\Domain\Scheduler\PriorityResolver(),new FrozenClock($nextAt)
+        );
+        $evaluator->execute($lease);
+        self::assertSame('2',$this->numeric($this->connection()->fetchOne('SELECT COUNT(*) FROM backup_requests WHERE guest_id=:guest',['guest'=>self::id('guest')])));
+        $claim=$this->store()->claim(new ClaimNextBackupCommand(self::id('worker-a'),$nextAt));
+        self::assertNotNull($claim);
+        self::assertNotSame(self::id('request-a'),$claim->id);
+        $prepared=(new DbalBackupSubmissionStore($this->connection(),new DbalBackupProblemRecorder()))->prepareAfterFullRevalidation(new SubmitClaimedBackupCommand($claim->id,self::id('audit-second-run'),$claim->claimToken,$claim->claimFence,$nextAt));
+        self::assertSame(SubmissionPreparationStatus::PreparedNow,$prepared->status);
+        fwrite(STDOUT,"AUDIT: unknown/forbidden_ambiguous -> new automatic request -> claimed -> prepared for second POST\n");
+    }
+
+    public function testAuditPreviousWriterFailsOnMigratedSchema(): void
+    {
+        $this->testProvenAbsentAmbiguousSubmissionBecomesUnknownExactlyOnce();
+        try {
+            $this->connection()->executeStatement("INSERT INTO backup_problem_states (root_request_id,problem_code,consecutive_failures,opened_at,last_occurred_at,last_notified_at,revision) VALUES (:root,'submission_rejected',1,:at,:at,:at,1) ON DUPLICATE KEY UPDATE revision=revision+1", ['root'=>self::id('request-a'),'at'=>self::format($this->now)]);
+            self::fail('The old insert unexpectedly succeeded.');
+        } catch (\Doctrine\DBAL\Exception $error) {
+            self::assertStringContainsString('obligation_id',$error->getMessage());
+            fwrite(STDOUT,"AUDIT: previous writer rejected because obligation_id has no default\n");
+        }
+    }
