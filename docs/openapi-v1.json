{
  "openapi": "3.1.0",
  "info": {
    "title": "Hoddmímir read-only API",
    "version": "1.0.0",
    "description": "The Phase 3 inventory and Phase 4 backup-target candidate reads are unauthenticated and may only be published on host loopback until authentication and RBAC are available."
  },
  "servers": [{"url": "/"}],
  "paths": {
    "/api/v1/inventory/overview": {
      "get": {
        "operationId": "getInventoryOverview",
        "responses": {
          "200": {"description": "Current inventory counts and UTC freshness.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InventoryOverview"}}}}
        }
      }
    },
    "/api/v1/inventory/resources": {
      "get": {
        "operationId": "listInventoryResources",
        "parameters": [
          {"$ref": "#/components/parameters/Kind"},
          {"$ref": "#/components/parameters/Limit"},
          {"$ref": "#/components/parameters/Cursor"},
          {"$ref": "#/components/parameters/ConnectionId"},
          {"$ref": "#/components/parameters/ParentId"},
          {"$ref": "#/components/parameters/InventoryState"},
          {"$ref": "#/components/parameters/GuestType"}
        ],
        "responses": {
          "200": {"description": "A bounded keyset page of inventory resources.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InventoryResourcePage"}}}},
          "400": {"$ref": "#/components/responses/InvalidQuery"}
        }
      }
    },
    "/api/v1/backup-target-candidates": {
      "get": {
        "operationId": "listBackupTargetCandidates",
        "parameters": [
          {"$ref": "#/components/parameters/Limit"},
          {"$ref": "#/components/parameters/Cursor"},
          {"$ref": "#/components/parameters/ConnectionId"},
          {"$ref": "#/components/parameters/ClusterId"}
        ],
        "responses": {
          "200": {"description": "A bounded keyset page of fail-closed backup-target candidates and their raw evidence.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BackupTargetCandidatePage"}}}},
          "400": {"$ref": "#/components/responses/InvalidQuery"},
          "503": {"$ref": "#/components/responses/ReadModelUnavailable"}
        }
      }
    },
    "/api/v1/collector/status": {
      "get": {
        "operationId": "getCollectorStatus",
        "responses": {
          "200": {"description": "Collector schedule and latest heartbeat without lease identity or credentials.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CollectorStatus"}}}}
        }
      }
    },
    "/api/v1/collector/runs": {
      "get": {
        "operationId": "listCollectorRuns",
        "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Cursor"}],
        "responses": {
          "200": {"description": "Latest bounded keyset page of inventory-sync runs.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CollectorRunPage"}}}},
          "400": {"$ref": "#/components/responses/InvalidQuery"}
        }
      }
    },
    "/api/v1/collector/scopes": {
      "get": {
        "operationId": "listCollectorScopes",
        "parameters": [{"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Cursor"}],
        "responses": {
          "200": {"description": "Bounded keyset page of parent and PBS-content scope results for one inventory-sync run.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CollectorScopePage"}}}},
          "400": {"$ref": "#/components/responses/InvalidQuery"}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Kind": {"name": "kind", "in": "query", "required": true, "schema": {"$ref": "#/components/schemas/InventoryResourceKind"}},
      "Limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}},
      "Cursor": {"name": "cursor", "in": "query", "schema": {"$ref": "#/components/schemas/PageCursor"}},
      "ConnectionId": {"name": "connectionId", "in": "query", "schema": {"$ref": "#/components/schemas/CanonicalUuid"}},
      "ClusterId": {"name": "clusterId", "in": "query", "schema": {"$ref": "#/components/schemas/CanonicalUuid"}},
      "ParentId": {"name": "parentId", "in": "query", "description": "Cluster, PBS server, datastore/parent namespace, namespace, or backup-group ID as required by the selected kind.", "schema": {"$ref": "#/components/schemas/CanonicalUuid"}},
      "InventoryState": {"name": "inventoryState", "in": "query", "schema": {"$ref": "#/components/schemas/InventoryState"}},
      "GuestType": {"name": "guestType", "in": "query", "schema": {"type": "string", "enum": ["qemu", "lxc"]}},
      "RunId": {"name": "runId", "in": "query", "required": true, "schema": {"$ref": "#/components/schemas/CanonicalUuid"}}
    },
    "responses": {
      "InvalidQuery": {"description": "Unknown, malformed, incompatible, or out-of-bounds query.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}},
      "ReadModelUnavailable": {"description": "The read-only projection is temporarily unavailable without exposing database or runtime details.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReadModelUnavailableError"}}}}
    },
    "schemas": {
      "CanonicalUuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
      "UtcTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
      "DecimalBytes": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$", "x-maximum": "18446744073709551615"},
      "PageCursor": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[A-Za-z0-9_-]+$"},
      "InventoryResourceKind": {"type": "string", "enum": ["pve_cluster", "pve_node", "pve_guest", "pve_storage", "pbs_server", "pbs_datastore", "pbs_namespace", "pbs_backup_group", "pbs_snapshot"]},
      "InventoryState": {"type": "string", "enum": ["active", "archived"], "default": "active"},
      "PageMetadata": {
        "type": "object", "additionalProperties": false,
        "required": ["limit", "count", "hasMore", "nextCursor"],
        "properties": {
          "limit": {"type": "integer", "minimum": 1, "maximum": 100},
          "count": {"type": "integer", "minimum": 0, "maximum": 100},
          "hasMore": {"type": "boolean"},
          "nextCursor": {"oneOf": [{"$ref": "#/components/schemas/PageCursor"}, {"type": "null"}]}
        }
      },
      "InventoryCounts": {
        "type": "object", "additionalProperties": false,
        "required": ["pveConnections", "pbsConnections", "pveClusters", "pveNodes", "qemuGuests", "lxcGuests", "pveStorages", "pbsServers", "pbsDatastores", "pbsNamespaces", "pbsBackupGroups", "pbsSnapshots"],
        "properties": {
          "pveConnections": {"type": "integer", "minimum": 0}, "pbsConnections": {"type": "integer", "minimum": 0},
          "pveClusters": {"type": "integer", "minimum": 0}, "pveNodes": {"type": "integer", "minimum": 0},
          "qemuGuests": {"type": "integer", "minimum": 0}, "lxcGuests": {"type": "integer", "minimum": 0},
          "pveStorages": {"type": "integer", "minimum": 0}, "pbsServers": {"type": "integer", "minimum": 0},
          "pbsDatastores": {"type": "integer", "minimum": 0}, "pbsNamespaces": {"type": "integer", "minimum": 0},
          "pbsBackupGroups": {"type": "integer", "minimum": 0}, "pbsSnapshots": {"type": "integer", "minimum": 0}
        }
      },
      "InventoryOverview": {
        "type": "object", "additionalProperties": false, "required": ["generatedAt", "latestInventoryAt", "counts"],
        "properties": {"generatedAt": {"$ref": "#/components/schemas/UtcTimestamp"}, "latestInventoryAt": {"oneOf": [{"$ref": "#/components/schemas/UtcTimestamp"}, {"type": "null"}]}, "counts": {"$ref": "#/components/schemas/InventoryCounts"}}
      },
      "InventoryResourceBase": {
        "type": "object",
        "required": ["id", "connectionId", "connectionName", "parentId", "displayName", "inventoryState", "firstSeenAt", "lastSeenAt", "archivedAt", "stateObservedAt"],
        "properties": {
          "id": {"$ref": "#/components/schemas/CanonicalUuid"}, "connectionId": {"$ref": "#/components/schemas/CanonicalUuid"},
          "connectionName": {"type": "string"}, "parentId": {"oneOf": [{"$ref": "#/components/schemas/CanonicalUuid"}, {"type": "null"}]},
          "displayName": {"type": "string"}, "inventoryState": {"$ref": "#/components/schemas/InventoryState"},
          "firstSeenAt": {"$ref": "#/components/schemas/UtcTimestamp"}, "lastSeenAt": {"$ref": "#/components/schemas/UtcTimestamp"},
          "archivedAt": {"oneOf": [{"$ref": "#/components/schemas/UtcTimestamp"}, {"type": "null"}]},
          "stateObservedAt": {"oneOf": [{"$ref": "#/components/schemas/UtcTimestamp"}, {"type": "null"}]}
        }
      },
      "PveClusterAttributes": {"type": "object", "additionalProperties": false, "required": ["topology"], "properties": {"topology": {"type": "string", "enum": ["clustered", "standalone"]}}},
      "PveNodeAttributes": {"type": "object", "additionalProperties": false, "required": ["apiStatus"], "properties": {"apiStatus": {"type": "string"}}},
      "PveGuestAttributes": {"type": "object", "additionalProperties": false, "required": ["guestType", "vmid", "template", "nodeId", "nodeName"], "properties": {"guestType": {"type": "string", "enum": ["qemu", "lxc"]}, "vmid": {"type": "integer", "minimum": 100}, "template": {"oneOf": [{"type": "boolean"}, {"type": "null"}]}, "nodeId": {"oneOf": [{"$ref": "#/components/schemas/CanonicalUuid"}, {"type": "null"}]}, "nodeName": {"oneOf": [{"type": "string"}, {"type": "null"}]}}},
      "PveStorageAttributes": {"type": "object", "additionalProperties": false, "required": ["storageType", "supportsBackup", "shared", "disabled", "content", "pbsServer", "pbsPort", "pbsDatastore", "pbsNamespace"], "properties": {"storageType": {"type": "string"}, "supportsBackup": {"type": "boolean"}, "shared": {"type": "boolean"}, "disabled": {"type": "boolean"}, "content": {"type": "array", "items": {"type": "string"}}, "pbsServer": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "pbsPort": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "pbsDatastore": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "pbsNamespace": {"oneOf": [{"type": "string"}, {"type": "null"}]}}},
      "PbsServerAttributes": {"type": "object", "additionalProperties": false, "required": ["nodeName", "version", "release", "repository", "uptimeSeconds", "memoryTotalBytes", "memoryUsedBytes", "rootTotalBytes", "rootUsedBytes", "rootAvailableBytes"], "properties": {"nodeName": {"type": "string"}, "version": {"type": "string"}, "release": {"type": "string"}, "repository": {"type": "string"}, "uptimeSeconds": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "memoryTotalBytes": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "memoryUsedBytes": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "rootTotalBytes": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "rootUsedBytes": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "rootAvailableBytes": {"oneOf": [{"type": "integer"}, {"type": "null"}]}}},
      "PbsDatastoreAttributes": {"type": "object", "additionalProperties": false, "required": ["backendType", "mountStatus", "maintenanceMode", "allowsBackupWrites", "capacitySemantics", "totalBytes", "usedBytes", "availableBytes"], "properties": {"backendType": {"type": "string"}, "mountStatus": {"type": "string"}, "maintenanceMode": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "allowsBackupWrites": {"type": "boolean"}, "capacitySemantics": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "totalBytes": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "usedBytes": {"oneOf": [{"type": "integer"}, {"type": "null"}]}, "availableBytes": {"oneOf": [{"type": "integer"}, {"type": "null"}]}}},
      "PbsNamespaceAttributes": {"type": "object", "additionalProperties": false, "required": ["datastoreId", "namespacePath", "namespaceDepth", "parentNamespaceId"], "properties": {"datastoreId": {"$ref": "#/components/schemas/CanonicalUuid"}, "namespacePath": {"type": "string"}, "namespaceDepth": {"type": "integer", "minimum": 0, "maximum": 8}, "parentNamespaceId": {"oneOf": [{"$ref": "#/components/schemas/CanonicalUuid"}, {"type": "null"}]}}},
      "PbsBackupGroupAttributes": {"type": "object", "additionalProperties": false, "required": ["namespaceId", "backupType", "backupId"], "properties": {"namespaceId": {"$ref": "#/components/schemas/CanonicalUuid"}, "backupType": {"type": "string", "enum": ["vm", "ct", "host"]}, "backupId": {"type": "string"}}},
      "PbsSnapshotAttributes": {"type": "object", "additionalProperties": false, "required": ["backupTime", "protected", "sizeBytes", "verificationState"], "properties": {"backupTime": {"$ref": "#/components/schemas/UtcTimestamp"}, "protected": {"type": "boolean"}, "sizeBytes": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}, "verificationState": {"oneOf": [{"type": "string", "enum": ["ok", "failed"]}, {"type": "null"}]}}},
      "PveClusterResource": {"allOf": [{"$ref": "#/components/schemas/InventoryResourceBase"}, {"type": "object", "required": ["kind", "attributes"], "properties": {"kind": {"const": "pve_cluster"}, "attributes": {"$ref": "#/components/schemas/PveClusterAttributes"}}}], "unevaluatedProperties": false},
      "PveNodeResource": {"allOf": [{"$ref": "#/components/schemas/InventoryResourceBase"}, {"type": "object", "required": ["kind", "attributes"], "properties": {"kind": {"const": "pve_node"}, "attributes": {"$ref": "#/components/schemas/PveNodeAttributes"}}}], "unevaluatedProperties": false},
      "PveGuestResource": {"allOf": [{"$ref": "#/components/schemas/InventoryResourceBase"}, {"type": "object", "required": ["kind", "attributes"], "properties": {"kind": {"const": "pve_guest"}, "attributes": {"$ref": "#/components/schemas/PveGuestAttributes"}}}], "unevaluatedProperties": false},
      "PveStorageResource": {"allOf": [{"$ref": "#/components/schemas/InventoryResourceBase"}, {"type": "object", "required": ["kind", "attributes"], "properties": {"kind": {"const": "pve_storage"}, "attributes": {"$ref": "#/components/schemas/PveStorageAttributes"}}}], "unevaluatedProperties": false},
      "PbsServerResource": {"allOf": [{"$ref": "#/components/schemas/InventoryResourceBase"}, {"type": "object", "required": ["kind", "attributes"], "properties": {"kind": {"const": "pbs_server"}, "attributes": {"$ref": "#/components/schemas/PbsServerAttributes"}}}], "unevaluatedProperties": false},
      "PbsDatastoreResource": {"allOf": [{"$ref": "#/components/schemas/InventoryResourceBase"}, {"type": "object", "required": ["kind", "attributes"], "properties": {"kind": {"const": "pbs_datastore"}, "attributes": {"$ref": "#/components/schemas/PbsDatastoreAttributes"}}}], "unevaluatedProperties": false},
      "PbsNamespaceResource": {"allOf": [{"$ref": "#/components/schemas/InventoryResourceBase"}, {"type": "object", "required": ["kind", "attributes"], "properties": {"kind": {"const": "pbs_namespace"}, "attributes": {"$ref": "#/components/schemas/PbsNamespaceAttributes"}}}], "unevaluatedProperties": false},
      "PbsBackupGroupResource": {"allOf": [{"$ref": "#/components/schemas/InventoryResourceBase"}, {"type": "object", "required": ["kind", "attributes"], "properties": {"kind": {"const": "pbs_backup_group"}, "attributes": {"$ref": "#/components/schemas/PbsBackupGroupAttributes"}}}], "unevaluatedProperties": false},
      "PbsSnapshotResource": {"allOf": [{"$ref": "#/components/schemas/InventoryResourceBase"}, {"type": "object", "required": ["kind", "attributes"], "properties": {"kind": {"const": "pbs_snapshot"}, "attributes": {"$ref": "#/components/schemas/PbsSnapshotAttributes"}}}], "unevaluatedProperties": false},
      "InventoryResource": {"oneOf": [{"$ref": "#/components/schemas/PveClusterResource"}, {"$ref": "#/components/schemas/PveNodeResource"}, {"$ref": "#/components/schemas/PveGuestResource"}, {"$ref": "#/components/schemas/PveStorageResource"}, {"$ref": "#/components/schemas/PbsServerResource"}, {"$ref": "#/components/schemas/PbsDatastoreResource"}, {"$ref": "#/components/schemas/PbsNamespaceResource"}, {"$ref": "#/components/schemas/PbsBackupGroupResource"}, {"$ref": "#/components/schemas/PbsSnapshotResource"}], "discriminator": {"propertyName": "kind"}},
      "InventoryResourcePage": {"type": "object", "additionalProperties": false, "required": ["items", "page"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/InventoryResource"}}, "page": {"$ref": "#/components/schemas/PageMetadata"}}},
      "BackupTargetBlockerCode": {"type": "string", "enum": ["freshness_policy_unconfigured", "connection_disabled", "connection_not_pve", "cluster_archived", "storage_archived", "storage_disabled", "backup_content_unsupported", "no_active_node", "no_usable_node", "storage_not_configured_on_node", "node_state_missing", "node_offline", "node_storage_disabled", "node_storage_inactive", "capacity_unavailable", "capacity_invalid", "pbs_mapping_missing", "pbs_endpoint_unresolved", "pbs_endpoint_ambiguous", "pbs_connection_disabled", "pbs_server_missing", "pbs_datastore_missing", "pbs_datastore_archived", "pbs_datastore_read_only", "pbs_namespace_missing", "pbs_namespace_archived", "pbs_capacity_missing", "pbs_remote_capacity_unproven"]},
      "BackupTargetCapacityStatus": {"type": "string", "enum": ["missing", "measured", "unavailable", "invalid"]},
      "PbsEndpointMatchStatus": {"type": "string", "enum": ["matched", "unresolved", "ambiguous"]},
      "BackupTargetNodeEvidence": {
        "type": "object", "additionalProperties": false,
        "required": ["nodeId", "nodeName", "configuredForStorage", "enabled", "active", "capacityStatus", "totalBytes", "usedBytes", "availableBytes", "observedAt", "blockers"],
        "properties": {
          "nodeId": {"$ref": "#/components/schemas/CanonicalUuid"},
          "nodeName": {"type": "string", "minLength": 1},
          "configuredForStorage": {"type": "boolean"},
          "enabled": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
          "active": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
          "capacityStatus": {"$ref": "#/components/schemas/BackupTargetCapacityStatus"},
          "totalBytes": {"oneOf": [{"$ref": "#/components/schemas/DecimalBytes"}, {"type": "null"}]},
          "usedBytes": {"oneOf": [{"$ref": "#/components/schemas/DecimalBytes"}, {"type": "null"}]},
          "availableBytes": {"oneOf": [{"$ref": "#/components/schemas/DecimalBytes"}, {"type": "null"}]},
          "observedAt": {"oneOf": [{"$ref": "#/components/schemas/UtcTimestamp"}, {"type": "null"}]},
          "blockers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/components/schemas/BackupTargetBlockerCode"}}
        }
      },
      "PbsBackupTargetEvidence": {
        "type": "object", "additionalProperties": false,
        "required": ["server", "port", "datastore", "namespace", "mappingObservedAt", "endpointMatch", "pbsConnectionId", "pbsServerId", "pbsDatastoreId", "pbsNamespaceId", "capacitySemantics", "totalBytes", "usedBytes", "availableBytes", "capacityObservedAt", "blockers"],
        "properties": {
          "server": {"type": "string", "minLength": 1, "maxLength": 255},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "datastore": {"type": "string", "minLength": 1, "maxLength": 190},
          "namespace": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 255}, {"type": "null"}]},
          "mappingObservedAt": {"$ref": "#/components/schemas/UtcTimestamp"},
          "endpointMatch": {"$ref": "#/components/schemas/PbsEndpointMatchStatus"},
          "pbsConnectionId": {"oneOf": [{"$ref": "#/components/schemas/CanonicalUuid"}, {"type": "null"}]},
          "pbsServerId": {"oneOf": [{"$ref": "#/components/schemas/CanonicalUuid"}, {"type": "null"}]},
          "pbsDatastoreId": {"oneOf": [{"$ref": "#/components/schemas/CanonicalUuid"}, {"type": "null"}]},
          "pbsNamespaceId": {"oneOf": [{"$ref": "#/components/schemas/CanonicalUuid"}, {"type": "null"}]},
          "capacitySemantics": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
          "totalBytes": {"oneOf": [{"$ref": "#/components/schemas/DecimalBytes"}, {"type": "null"}]},
          "usedBytes": {"oneOf": [{"$ref": "#/components/schemas/DecimalBytes"}, {"type": "null"}]},
          "availableBytes": {"oneOf": [{"$ref": "#/components/schemas/DecimalBytes"}, {"type": "null"}]},
          "capacityObservedAt": {"oneOf": [{"$ref": "#/components/schemas/UtcTimestamp"}, {"type": "null"}]},
          "blockers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/components/schemas/BackupTargetBlockerCode"}}
        }
      },
      "BackupTargetCandidate": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "connectionId", "connectionName", "clusterId", "clusterName", "storageName", "storageType", "shared", "inventoryState", "observedAt", "canEnable", "nodes", "pbs", "blockers"],
        "properties": {
          "id": {"$ref": "#/components/schemas/CanonicalUuid"},
          "connectionId": {"$ref": "#/components/schemas/CanonicalUuid"},
          "connectionName": {"type": "string", "minLength": 1},
          "clusterId": {"$ref": "#/components/schemas/CanonicalUuid"},
          "clusterName": {"type": "string", "minLength": 1},
          "storageName": {"type": "string", "minLength": 1, "maxLength": 190},
          "storageType": {"type": "string", "minLength": 1, "maxLength": 64},
          "shared": {"type": "boolean"},
          "inventoryState": {"$ref": "#/components/schemas/InventoryState"},
          "observedAt": {"$ref": "#/components/schemas/UtcTimestamp"},
          "canEnable": {"type": "boolean"},
          "nodes": {"type": "array", "maxItems": 128, "items": {"$ref": "#/components/schemas/BackupTargetNodeEvidence"}},
          "pbs": {"oneOf": [{"$ref": "#/components/schemas/PbsBackupTargetEvidence"}, {"type": "null"}]},
          "blockers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/components/schemas/BackupTargetBlockerCode"}}
        }
      },
      "BackupTargetCandidatePage": {"type": "object", "additionalProperties": false, "required": ["items", "page"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/BackupTargetCandidate"}}, "page": {"$ref": "#/components/schemas/PageMetadata"}}},
      "CollectorScheduleUnconfigured": {"type": "object", "additionalProperties": false, "required": ["configured"], "properties": {"configured": {"const": false}}},
      "CollectorScheduleConfigured": {"type": "object", "additionalProperties": false, "required": ["configured", "intervalSeconds", "nextScanAt", "lastCycleStartedAt", "lastCycleFinishedAt", "leaseActive", "leaseExpiresAt"], "properties": {"configured": {"const": true}, "intervalSeconds": {"type": "integer", "minimum": 1}, "nextScanAt": {"$ref": "#/components/schemas/UtcTimestamp"}, "lastCycleStartedAt": {"oneOf": [{"$ref": "#/components/schemas/UtcTimestamp"}, {"type": "null"}]}, "lastCycleFinishedAt": {"oneOf": [{"$ref": "#/components/schemas/UtcTimestamp"}, {"type": "null"}]}, "leaseActive": {"type": "boolean"}, "leaseExpiresAt": {"oneOf": [{"$ref": "#/components/schemas/UtcTimestamp"}, {"type": "null"}]}}},
      "CollectorHeartbeat": {"type": "object", "additionalProperties": false, "required": ["status", "startedAt", "heartbeatAt", "expiresAt", "fresh", "currentActivity", "nextActionAt", "buildVersion"], "properties": {"status": {"type": "string", "enum": ["starting", "ready", "busy", "degraded", "stopping"]}, "startedAt": {"$ref": "#/components/schemas/UtcTimestamp"}, "heartbeatAt": {"$ref": "#/components/schemas/UtcTimestamp"}, "expiresAt": {"$ref": "#/components/schemas/UtcTimestamp"}, "fresh": {"type": "boolean"}, "currentActivity": {"oneOf": [{"type": "string"}, {"type": "null"}]}, "nextActionAt": {"oneOf": [{"$ref": "#/components/schemas/UtcTimestamp"}, {"type": "null"}]}, "buildVersion": {"type": "string"}}},
      "CollectorStatus": {"type": "object", "additionalProperties": false, "required": ["generatedAt", "schedule", "heartbeat"], "properties": {"generatedAt": {"$ref": "#/components/schemas/UtcTimestamp"}, "schedule": {"oneOf": [{"$ref": "#/components/schemas/CollectorScheduleUnconfigured"}, {"$ref": "#/components/schemas/CollectorScheduleConfigured"}]}, "heartbeat": {"oneOf": [{"$ref": "#/components/schemas/CollectorHeartbeat"}, {"type": "null"}]}}},
