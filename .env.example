APP_ENV=dev
APP_DEBUG=1
APP_TIMEZONE=UTC

WEB_PORT=8080
APP_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=512m
APP_PIDS_LIMIT=128
MARIADB_CPU_LIMIT=2.0
MARIADB_MEMORY_LIMIT=2g
MARIADB_PIDS_LIMIT=256

MARIADB_DATABASE=hoddmimir
ENCRYPTION_KEYRING_REVISION=1
COLLECTOR_GRID_WIDTH_SECONDS=120
EVIDENCE_FRESHNESS_SECONDS=300
BACKUP_QUEUE_DEFER_SECONDS=120
PVE_STORAGE_MAX_NODE_FANOUT=128
PBS_MAX_DATASTORE_FANOUT=128
PBS_CONTENT_MAX_DATASTORES=128
PBS_CONTENT_MAX_NAMESPACES_PER_DATASTORE=1024
PBS_CONTENT_MAX_SNAPSHOTS_PER_NAMESPACE=65536
PBS_CONTENT_MAX_TOTAL_SNAPSHOTS=262144
PBS_CONTENT_NAMESPACE_BODY_BYTES=8388608
PBS_CONTENT_SNAPSHOT_BODY_BYTES=67108864
MONITOR_HISTORY_OVERLAP_SECONDS=300
PVE_MONITOR_PAGE_SIZE=100
PVE_MONITOR_MAX_NODES=128
PVE_MONITOR_ACTIVE_PAGE_CAP=2
PVE_MONITOR_ARCHIVE_PAGE_CAP=10
PVE_MONITOR_REQUEST_LIMIT=512
PVE_MONITOR_RAW_ROW_LIMIT=25000
PVE_MONITOR_DISTINCT_TASK_LIMIT=25000
PVE_MONITOR_HISTORY_WINDOW_SECONDS=86400
PBS_MONITOR_PAGE_SIZE=256
PBS_MONITOR_MAX_PAGES_PER_STREAM=16
PBS_MONITOR_MAX_ROWS_PER_STREAM=4096
PBS_MONITOR_MAX_JOBS_PER_KIND=4096
PBS_MONITOR_HISTORY_WINDOW_SECONDS=86400
APP_BUILD_VERSION=development
BACKUP_WORKER_POLL_INTERVAL_SECONDS=5
BACKUP_EXECUTION_ENABLED=false
BACKUP_WORKER_HEARTBEAT_TTL_SECONDS=150
MATRIX_NOTIFICATION_ENABLED=false
MATRIX_WEBHOOK_CHANNEL=proxmox-backup
MATRIX_WEBHOOK_TIMEOUT_SECONDS=10
MATRIX_WEBHOOK_URL_FILE=/run/secrets/matrix_webhook_url

# Passwords and encryption keys are generated into .secrets/ by
# scripts/init-dev-secrets.sh and are never stored in this file.
